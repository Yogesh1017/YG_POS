{
  "name": "yg-pos",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:web": "next build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build": "next build && node scripts/build-desktop.mjs",
    "start": "electron .",
    "serve": "node dist-desktop/dev-server.js",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "lint": "eslint src desktop tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "test:desktop": "node e2e/desktop.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "description": "Offline wholesale billing and stock for a single Windows computer",
  "author": "YG POS",
  "license": "MIT",
  "main": "dist-desktop/main.js",
  "build": {
    "appId": "in.ygpos.desktop",
    "productName": "YG POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist-desktop/main.js",
      "dist-desktop/preload.js",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "YG POS",
      "deleteAppDataOnUninstall": false,
      "artifactName": "YG-POS-Setup-${version}.${ext}"
    }
  }
}
