# Copy to .env.local and fill in from your Supabase project (Settings -> API).
# Both values are safe to ship to the browser: access is enforced by Row Level Security.
# NEVER put the service_role key here or anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
